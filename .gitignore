# Unity 工程 .gitignore —— 放置于 Unity 项目根目录
# 参考 https://github.com/github/gitignore/blob/main/Unity.gitignore

# Unity 生成目录（体积巨大，绝不入库）
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# 自动生成的 IDE / VS 工程文件
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 生成的 meta
*.pidb.meta
*.pdb.meta
*.mdb.meta

# 崩溃报告
sysinfo.txt

# 构建产物
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Addressables 打包数据
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# 系统垃圾文件
.DS_Store
Thumbs.db